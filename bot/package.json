    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "domhandler": "^5.0.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }

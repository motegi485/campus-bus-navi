{
  "name": "campus-bus-navi-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "福山大学スクールバス時刻表の自動取り込み Bot（フロントエンドとは依存を分離する）",
  "scripts": {
    "start": "tsx src/index.ts",
